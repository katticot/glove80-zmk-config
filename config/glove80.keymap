/*
 * MoErgo Glove80 Clean Minimal Keymap (Colemak-DH + Bilateral HRM + Numpad/Nav + Magic)
 * Optimized & Verified for: Keita
 * 
 * Total Layers: 3 (Clean Architecture)
 *   0: Base (Colemak-DH Engrammer + Bilateral HRMs)
 *   1: Numpad & Directionals (Hold Tab T2 or Enter T6)
 *   2: Hardware Magic & Bluetooth (Press Magic Key LH C6R6)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

#define LAYER_BASE   0
#define LAYER_NUMNAV 1
#define LAYER_MAGIC  2

/ {
    behaviors {
        // Left Hand Bilateral Home Row Modifiers
        lh_p_alt: lh_p_alt {
            compatible = "zmk,behavior-hold-tap";
            label = "LH_PINKY_ALT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42 43 44 45 58 59 60 61 62 63 76 77 78 79>;
        };

        lh_r_gui: lh_r_gui {
            compatible = "zmk,behavior-hold-tap";
            label = "LH_RING_GUI";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42 43 44 45 58 59 60 61 62 63 76 77 78 79>;
        };

        lh_m_ctl: lh_m_ctl {
            compatible = "zmk,behavior-hold-tap";
            label = "LH_MID_CTL";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42 43 44 45 58 59 60 61 62 63 76 77 78 79>;
        };

        lh_i_sft: lh_i_sft {
            compatible = "zmk,behavior-hold-tap";
            label = "LH_IDX_SFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42 43 44 45 58 59 60 61 62 63 76 77 78 79>;
        };

        // Right Hand Bilateral Home Row Modifiers
        rh_i_sft: rh_i_sft {
            compatible = "zmk,behavior-hold-tap";
            label = "RH_IDX_SFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39 46 47 48 49 50 51 64 65 66 67 68 69 70 71 72 73 74 75>;
        };

        rh_m_ctl: rh_m_ctl {
            compatible = "zmk,behavior-hold-tap";
            label = "RH_MID_CTL";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39 46 47 48 49 50 51 64 65 66 67 68 69 70 71 72 73 74 75>;
        };

        rh_r_gui: rh_r_gui {
            compatible = "zmk,behavior-hold-tap";
            label = "RH_RING_GUI";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39 46 47 48 49 50 51 64 65 66 67 68 69 70 71 72 73 74 75>;
        };

        rh_p_alt: rh_p_alt {
            compatible = "zmk,behavior-hold-tap";
            label = "RH_PINKY_ALT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39 46 47 48 49 50 51 64 65 66 67 68 69 70 71 72 73 74 75>;
        };

        // Thumb Layer-Tap Behaviors
        lt_tab_num: lt_tab_num {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TAB_NUM";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        lt_ent_num: lt_ent_num {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_ENT_NUM";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ------------------------------------------------------------------------
        // Layer 0: Base Layer (Colemak-DH Engrammer + Bilateral HRMs)
        // ------------------------------------------------------------------------
        layer_base {
            bindings = <
                // Row 0: Function Row (10 keys)
                &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                  &kp F6        &kp F7        &kp F8        &kp F9        &kp F10
                // Row 1: Number Row (12 keys)
                &kp EQUAL     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5    &kp N6        &kp N7        &kp N8        &kp N9        &kp N0        &kp MINUS
                // Row 2: Top Row (12 keys)
                &kp TAB       &kp Q         &kp W         &kp F         &kp P         &kp B     &kp J         &kp L         &kp U         &kp Y         &kp SQT       &kp BSLH
                // Row 3: Home Row (12 keys)
                &kp ESC       &lh_p_alt LALT A  &lh_r_gui LGUI R  &lh_m_ctl LCTRL S  &lh_i_sft LSHIFT T  &kp G    &kp M  &rh_i_sft RSHIFT N &rh_m_ctl RCTRL E  &rh_r_gui RGUI I  &rh_p_alt RALT O  &kp SEMI
                // Row 4: Bottom Row (12 keys)
                &kp GRAVE     &kp Z         &kp X         &kp C         &kp D         &kp V     &kp K         &kp H         &kp COMMA     &kp DOT       &kp FSLH      &kp PLUS
                // Row 5: Inner / Matrix filler (10 keys: 5 LH + 5 RH)
                &mo LAYER_MAGIC &kp HOME    &kp END       &kp LEFT      &kp RIGHT               &kp UP        &kp DOWN      &kp LBKT      &kp RBKT      &kp PG_UP
                // Thumb Clusters (12 keys: 6 LH + 6 RH)
                // Left Thumbs (T1..T6)
                &kp ESC       &lt_tab_num LAYER_NUMNAV TAB &kp END
                &kp SPACE     &kp BSPC      &lt_ent_num LAYER_NUMNAV RET
                // Right Thumbs (T1..T6)
                &kp SPACE     &kp DEL       &kp RCTRL
                &kp RET       &kp RALT      &kp RGUI
            >;
        };

        // ------------------------------------------------------------------------
        // Layer 1: Directional Numpad & Symbols (Hold Tab / Enter)
        // ------------------------------------------------------------------------
        layer_numnav {
            bindings = <
                // Row 0: Function Row (10 keys)
                &trans        &trans        &trans        &trans        &trans                  &trans        &trans        &trans        &trans        &trans
                // Row 1: Number Row (12 keys)
                &trans        &trans        &trans        &trans        &trans        &trans    &kp EQUAL     &kp KP_SLASH  &kp KP_MULTIPLY &kp KP_MINUS &kp KP_PLUS  &trans
                // Row 2: Top Row (12 keys)
                &trans        &kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT &kp KP_N7     &kp KP_N8     &kp KP_N9     &kp KP_PLUS   &kp KP_ASTERISK &trans
                // Row 3: Home Row (12 keys)
                &trans        &kp CARET     &kp AMPS      &kp STAR      &kp LPAR      &kp RPAR  &kp KP_N4     &kp KP_N5     &kp KP_N6     &kp KP_MINUS  &kp KP_ENTER  &trans
                // Row 4: Bottom Row (12 keys)
                &trans        &kp TILDE     &kp UNDER     &kp PLUS      &kp LBRC      &kp RBRC  &kp KP_N1     &kp KP_N2     &kp KP_N3     &kp KP_DOT    &kp KP_SLASH  &trans
                // Row 5: Inner Reach (10 keys)
                &trans        &trans        &trans        &trans        &trans                  &kp HOME      &kp END       &kp LEFT      &kp RIGHT     &kp PG_DN
                // Thumb Clusters (12 keys)
                &trans        &trans        &trans
                &trans        &trans        &trans
                &kp KP_N0     &kp KP_DOT    &kp KP_ENTER
                &kp RET       &trans        &trans
            >;
        };

        // ------------------------------------------------------------------------
        // Layer 2: Hardware Magic & Bluetooth (Tap Magic Key)
        // ------------------------------------------------------------------------
        layer_magic {
            bindings = <
                // Row 0: Function Row (10 keys)
                &bootloader   &trans        &trans        &trans        &trans                  &trans        &trans        &trans        &trans        &bootloader
                // Row 1: Number Row (12 keys)
                &trans        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans    &trans        &rgb_ug RGB_TOG &rgb_ug RGB_EFF &rgb_ug RGB_BRI &rgb_ug RGB_BRD &trans
                // Row 2: Top Row (12 keys)
                &trans        &bt BT_CLR    &bt BT_PRV    &bt BT_NXT    &trans        &trans    &out OUT_TOG  &out OUT_USB  &out OUT_BLE  &trans        &trans        &trans
                // Row 3: Home Row (12 keys)
                &trans        &trans        &trans        &trans        &trans        &trans    &trans        &trans        &trans        &trans        &trans        &trans
                // Row 4: Bottom Row (12 keys)
                &trans        &trans        &trans        &trans        &trans        &trans    &trans        &trans        &trans        &trans        &trans        &trans
                // Row 5: Inner Reach (10 keys)
                &trans        &trans        &trans        &trans        &trans                  &trans        &trans        &trans        &trans        &trans
                // Thumb Clusters (12 keys)
                &trans        &trans        &trans
                &trans        &trans        &trans
                &trans        &trans        &trans
                &trans        &trans        &trans
            >;
        };
    };
};
